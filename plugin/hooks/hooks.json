{
  "description": "Vector memory lifecycle hooks: session context loading and waypoint checkpoints (compaction, /clear, /exit)",
  "modules": ["./mods/index.ts"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "start",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.ts\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-clear.ts\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
